// WSLPE #40: MIDL interface contract for a local-only educational RPC fixture.
// NOT a complete or deployable authorization scenario. Its eventual service
// must use ncalrpc only, reject network transports, and write only owned proof.
// handle_t is defined by MIDL; no external rpc.idl import required.

[
  uuid(4D9A3840-AD40-4E2F-8040-5B3139D45A40),
  version(1.0),
  pointer_default(unique)
]
interface Kingdom40LocalRpc
{
    void Kingdom40Status(
        [in] handle_t binding,
        [out] long* result
    );

    // Intentionally misconfigured *per-operation authorization*:
    // authenticated local standard-user callers may request a privileged
    // proof of their chosen nonce in the dedicated protected fixture only.
    // No caller-controlled paths, commands or external network transports.
    void Kingdom40OwnedProof(
        [in] handle_t binding,
        [in] unsigned long nonce,
        [out] long* result
    );
};
