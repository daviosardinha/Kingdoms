# Kingdoms WSLPE: first-class independent, single-machine Windows LPE lab.
# Rendered through the EXISTING Kingdoms instance/Vagrant template, not a
# separate Vagrant project. The machine uses its own generated instance state.
# No vmnet number is pinned here. The existing Kingdoms VMware template
# provides the Vagrant private exercise network and provider-managed NAT.
# Each operator host must validate its networks independently before install.
# Future cloud/VPS deployment requires a separate provider adapter.
boxes = [
  {
    :name => "WSLPE-WS01",
    :hostname => "wslpe-ws01",
    :ip => "{{ip_range}}.31",
    :box => "mayfly/windows10",
    :box_version => "2024.01.06",
    :os => "windows",
    :cpus => 2,
    :mem => 4096
  }
]

# Opt-in ONLY for a new disposable VMware source candidate.
# Source preview makes no host/guest change; this is NOT a portless deployment.
# Existing WSLPE masters and the default learner lab must retain two NICs.
if ENV["KINGDOMS_WSLPE_DISPOSABLE_MGMT_NIC"] == "preview"
  vmnet = ENV.fetch("KINGDOMS_WSLPE_DISPOSABLE_MGMT_VMNET", "")
  prefix = ENV.fetch("KINGDOMS_WSLPE_DISPOSABLE_MGMT_PREFIX", "")
  if !vmnet.match?(/\Avmnet\d+\z/) ||
     ["vmnet0", "vmnet1", "vmnet8", "vmnet10", "vmnet20",
      "vmnet30", "vmnet99"].include?(vmnet)
    raise "WSLPE disposable management vmnet is missing or reserved"
  end
  unless prefix.match?(/\A(?:\d{1,3}\.){2}\d{1,3}\z/) &&
         prefix != "{{ip_range}}"
    raise "WSLPE disposable management prefix is missing or matches the exercise subnet"
  end
  if File.exist?(File.join(__dir__, ".vagrant", "machines", "WSLPE-WS01",
                            "vmware_desktop", "id"))
    raise "WSLPE disposable management NIC refused on an existing VM registration"
  end
  # Shared provider template already supports explicit VMware NIC slots.
  # The VMware plugin generates the MAC when :mac is nil. Windows needs a
  # separately reviewed MAC-bound static-address configuration after bootstrap.
  boxes[0][:vmware_network_adapters] = [
    { :slot => 2, :vnet => vmnet, :mac => nil }
  ]
  boxes[0][:wslpe_disposable_management_prefix] = prefix
end
